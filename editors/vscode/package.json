{
  "name": "tenma",
  "displayName": "Tenma",
  "description": "Debug PHP apps running under tenma --inspect",
  "version": "0.1.0",
  "publisher": "systonia",
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/systonia/Tenma",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Debuggers"],
  "main": "./extension.js",
  "activationEvents": ["onDebug"],
  "contributes": {
    "breakpoints": [{ "language": "php" }],
    "debuggers": [
      {
        "type": "tenma",
        "label": "Tenma",
        "languages": ["php"],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "host": { "type": "string", "description": "Address of tenma --inspect", "default": "127.0.0.1" },
              "port": { "type": "number", "description": "Port of tenma --inspect", "default": 9229 }
            }
          }
        },
        "initialConfigurations": [
          { "type": "tenma", "request": "attach", "name": "Attach to tenma --inspect", "port": 9229 }
        ],
        "configurationSnippets": [
          {
            "label": "Tenma: attach",
            "description": "Attach to tenma --inspect",
            "body": { "type": "tenma", "request": "attach", "name": "Attach to tenma --inspect", "port": 9229 }
          }
        ]
      }
    ]
  }
}
